{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "incremental": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  "exclude": ["src/components/Allowlist.tsx","src/components/Analytics.tsx","src/components/Approvals.tsx","src/components/CreateLeash.tsx","src/components/Dashboard.tsx","src/components/DemoPanel.tsx","src/components/Feed.tsx","src/components/OwnerControls.tsx","src/components/Recurring.tsx","src/components/RevokeButton.tsx","src/components/LeashList.tsx","src/hooks/useLeash.ts","src/hooks/useLeashEvents.ts","src/hooks/useSend.ts","src/lib/agentLeashAbi.ts","src/lib/chain.ts","src/lib/demoRunner.ts","src/lib/demo.ts","src/onchain-facts.ts","src/onchain-money.ts","src/onchain-wait.ts","src/tracing.ts","src/console-capture.ts"]
}
